# 복사해서 쓰세요:  cp .env.deploy.example .env.deploy
# 배포 전용 자격증명. Next 빌드가 읽지 않는 파일이라 워커 번들에 들어가지 않습니다.
# `npm run cf:deploy` 가 이 파일을 읽어 wrangler 에 넘깁니다. .env.deploy 는 gitignore 되어 있습니다.

# https://dash.cloudflare.com/profile/api-tokens — "Edit Cloudflare Workers" 템플릿 + D1 편집 권한
CLOUDFLARE_API_TOKEN=
# 대시보드 오른쪽 사이드바의 Account ID
CLOUDFLARE_ACCOUNT_ID=
