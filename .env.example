# 복사해서 쓰세요:  cp .env.example .env
# .env 는 gitignore 되어 있습니다. 실제 키는 절대 이 파일에 넣지 마세요.

# ── 생성 엔진 ─────────────────────────────────────────────
# fal.ai API 키 (https://fal.ai/dashboard/keys). 비워 두면 MOCK 모드로 동작합니다(실제 생성 없음).
FAL_KEY=

# 로컬 개발에서 서버 FAL_KEY 로 대신 생성하는 것을 허용합니다.
# 공개 배포(BYOK)에서는 비워 두세요 — 방문자가 각자 자기 키를 브라우저에 넣어 씁니다.
ALLOW_SERVER_KEY=1

# 1이면 방문자가 각자 자기 fal 키를 넣어 쓰는 공개 배포 모드. 로컬에서는 비워 둡니다.
BYOK_MODE=

# 사용자 식별 쿠키 서명용 비밀값. BYOK_MODE=1 이면 필수입니다.
# 생성:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 1이면 FAL_KEY 가 있어도 MOCK 모드
MOCK_FAL=

# MOCK 모드에서 작업을 실패시킬 확률 (0~1). 환불 경로 검증용
MOCK_FAIL_RATE=0

# ── 요금·크레딧 ───────────────────────────────────────────
# 크레딧 = 원가 $0.01 × CREDIT_MARKUP  (BYOK 에서는 크레딧을 쓰지 않고 USD 견적만 표시)
CREDIT_MARKUP=2

# fal H3-Max 출력 요금 (USD / 초)
PRICE_OUTPUT_480P=0.05
PRICE_OUTPUT_768P=0.08

# 1이면 크레딧 잔액 검사와 차감을 건너뜁니다 (로컬 전용)
UNLIMITED_CREDITS=1

# ── 동작 ──────────────────────────────────────────────────
# balanced | quality
FAL_PROMPT_EXPANSION=balanced

# 로컬 저장 위치
STORAGE_DIR=./storage
DATABASE_PATH=./data/click2video.db

# 러너가 동시에 fal 에 올려 두는 작업 수 (기본 2)
RUNNER_CONCURRENCY=2

# ── 배포 ──────────────────────────────────────────────────
# Cloudflare 자격증명은 이 파일이 아니라 .env.deploy 에 두세요 (.env.deploy.example 참고).
# .env 에 두면 빌드 시 워커 번들에 그대로 박힙니다.
# PUBLIC_BASE_URL(배포 주소)은 여기가 아니라 wrangler.local.jsonc 의 vars 에 넣습니다.
