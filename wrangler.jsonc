{
  // ─────────────────────────────────────────────────────────────────────────────
  // 템플릿입니다. 자기 Cloudflare 계정에 배포하려면 (자세한 순서는 README "내 Cloudflare 에 배포"):
  //   1) cp wrangler.jsonc wrangler.local.jsonc   (wrangler.local.jsonc 는 gitignore 됨)
  //   2) npx wrangler d1 create click2video       → 출력된 database_id 를 <YOUR_D1_DATABASE_ID> 자리에 넣습니다
  //   3) PUBLIC_BASE_URL 을 배포될 주소(https://click2video.<서브도메인>.workers.dev)로 바꿉니다
  //   4) npm run cf:migrate                       → D1 스키마 적용
  //   5) SESSION_SECRET 등록 (npm run cf:secret -- SESSION_SECRET, 값은 stdin)
  //   6) npm run cf:deploy -- --build
  // cf 스크립트는 wrangler.local.jsonc 가 있으면 그것을, 없으면 이 파일을 씁니다.
  // ─────────────────────────────────────────────────────────────────────────────
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "click2video",
  "main": "cf/worker.ts",
  "compatibility_date": "2026-09-01",
  // nodejs_compat: Buffer / node:crypto 등을 쓰기 위해 필요. OpenNext 가 요구한다.
  // global_fetch_strictly_public: Worker 안에서 자기 자신의 공개 URL 을 fetch 할 수 있게 한다.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "click2video",
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "drizzle"
    }
  ],
  // BYOK 배포에서는 서버에 키가 없어 크론이 작업을 진행시킬 수 없다(브라우저가 /step 으로 민다).
  // 크론이 돌면 키 없는 작업을 실패 처리해 버리므로 트리거를 두지 않는다.
  "vars": {
    "CREDIT_MARKUP": "2",
    "PRICE_OUTPUT_480P": "0.05",
    "PRICE_OUTPUT_768P": "0.08",
    "FAL_PROMPT_EXPANSION": "balanced",
    // 방문자가 각자 자기 fal 키를 넣어 쓴다. 서버 키 폴백(ALLOW_SERVER_KEY)은 일부러 두지 않는다 —
    // 이게 없으면 모든 방문자의 생성이 운영자 계정으로 과금된다.
    "BYOK_MODE": "1",
    // 배포 주소. R2 가 없을 때 fal 이 샘플·레퍼런스 파일을 이 주소에서 직접 가져간다.
    "PUBLIC_BASE_URL": "https://click2video.<YOUR_SUBDOMAIN>.workers.dev"
  }
}
