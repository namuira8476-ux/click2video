# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 값이 든 파일은 전부 제외하고, 값이 빈 템플릿만 공개한다
.env*
!.env.example
!.env.deploy.example
# 값이 모두 빈 배포 빌드 오버라이드 — 공개해야 다른 사람이 배포할 때 키를 번들에 굽지 않는다
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# click2video
/storage/
/data/
!/public/samples/

# 배포 빌드 산출물 — next-env.mjs 에 .env 값이 그대로 스냅샷된다 (절대 커밋 금지)
/.open-next/
/.wrangler/
.env.deploy

# 운영자 본인의 실제 배포 설정(D1 id, 공개 URL). 공개 저장소에는 템플릿 wrangler.jsonc 만 올라간다.
/wrangler.local.jsonc

# 샘플 브랜드명을 바꾸기 전에 만든 프리뷰 — 공개본에서는 썸네일만 보인다 (npm run e2e → promote 로 다시 만들 수 있음)
/public/samples/black-studio-launch/preview.mp4
